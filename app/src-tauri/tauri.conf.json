{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screen Bright Controller",
  "mainBinaryName": "ScreenBrightController",
  "version": "0.5.0",
  "identifier": "io.github.screenbrightcontroller",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Screen Bright Controller",
        "width": 740,
        "height": 390,
        "minWidth": 480,
        "minHeight": 350,
        "center": true,
        "visible": false
      },
      {
        "label": "popup",
        "title": "Screen Bright Controller tray",
        "url": "popup.html",
        "width": 430,
        "height": 340,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "publisher": "HanChangHun",
    "homepage": "https://github.com/HanChangHun/ScreenBrightController",
    "shortDescription": "Per-display gamma dimming with a recovery watchdog",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Korean"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
