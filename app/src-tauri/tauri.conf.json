{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screen Bright Controller",
  "version": "0.3.0",
  "identifier": "io.github.screenbrightcontroller",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Screen Bright Controller",
        "width": 740,
        "height": 610,
        "minWidth": 480,
        "minHeight": 540,
        "center": true
      },
      {
        "label": "popup",
        "title": "Screen Bright Controller tray",
        "url": "popup.html",
        "width": 430,
        "height": 540,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
